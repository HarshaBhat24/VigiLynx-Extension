{
  "name": "phish_mal_extension",
  "version": "1.1.0",
  "description": "Chrome extension for detecting phishing and malware through URL and file scanning",
  "main": "scripts/background.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"Building extension...\" && zip -r phish_mal_extension.zip . -x \"*.git*\" -x \"node_modules/*\"",
    "lint": "eslint scripts/*.js pages/*.js",
    "dev": "web-ext run --source-dir=."
  },
  "keywords": [
    "chrome-extension",
    "security",
    "phishing",
    "malware",
    "url-scanning"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.47.0",
    "web-ext": "^7.6.2"
  }
}
